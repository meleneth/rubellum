#!/usr/bin/env ruby
require_relative "../config/boot"
require_relative "../lib/rubellum/session_agent"

scope = JSON.parse(ARGV.fetch(0))
root = ARGV.fetch(1)
directory = File.join(root, "runtime/sessions", scope.fetch("session_id"), scope.fetch("generation").to_s)
workspace = File.join(root, "apps", scope.fetch("app_installation_id"), "workspaces", scope.fetch("notebook_id"))
FileUtils.mkdir_p(workspace, mode: 0o700)
journal = Rubellum::RuntimeJournal.new(directory:)
evaluator = Rubellum::EvaluatorProcess.new(workspace:)
transport = Rubellum::SqsTransport.local(endpoint: ENV.fetch("SQS_ENDPOINT", "http://127.0.0.1:4100"))
agent = Rubellum::SessionAgent.new(scope:, journal:, evaluator:, transport:)
Signal.trap("TERM") { exit }
begin
  until agent.stopped
    agent.step
    sleep 0.1
  end
ensure
  agent.close
end
